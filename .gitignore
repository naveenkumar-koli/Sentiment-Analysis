# ─── Virtual Environment ──────────────────────────────
.venv/
venv/
env/

# ─── Python Cache ─────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ─── Build & Distribution (PyInstaller output) ────────
dist/
build/
*.egg-info/

# ─── IDE / Editor ─────────────────────────────────────
.idea/
.vscode/

# ─── OS Junk ──────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── NLTK Data ────────────────────────────────────────
app/nltk_data/
app/nltk_data_lean/

# ─── ML Model Files ───────────────────────────────────
# Block ONLY the heavy fine-tuned DeBERTa model (541 MB)
app/models/deberta_sales_v1/

# Block loose pkl/model files directly inside app/ root
app/*.pkl
app/*.model

# Allow small logistic pkl files inside app/models/ (tracked)
!app/models/New_Updated_Models/
!app/models/New_Updated_Models/*.pkl
!app/models/New_Updated_Models/*.model
!app/models/*.pkl

# ─── Office / Data Files ──────────────────────────────
*.docx
*.xlsx
*.xls
*.csv

# ─── Spec files (PyInstaller) ─────────────────────────
*.spec

# ─── Reports ──────────────────────────────────────────
reports/

# ─── Jupyter Checkpoints ──────────────────────────────
.ipynb_checkpoints/

# ─── Logs ─────────────────────────────────────────────
*.log
*.tmp
